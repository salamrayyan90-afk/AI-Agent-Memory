# Core AI — Environment Variables (2026)
# Copy to .env and set values. Never commit .env.
# الاتصالات: Groq, GitHub, Gemini, Web Search (duckduckgo-search)

# Required: Groq (chat + vision)
GROQ_API_KEY=your_groq_api_key_here

# Required: GitHub (RAG, knowledge_base.md push/pull)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_REPO=your_username/your_private_repo_name

# Required: Gemini Neural Link (CORE AI identity)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Alpha Vantage (finance research)
# ALPHA_VANTAGE_API_KEY=your_key

# Web Search: pip install duckduckgo-search (no .env key)
